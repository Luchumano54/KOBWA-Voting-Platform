# These are plain environment variables. The app does not read this file itself:
# export them, set them in your service/IIS/Docker definition, or (for docker compose)
# put the BOOTSTRAP_* ones in a .env file next to docker-compose.yml. All are optional.

# Where the SQLite database and uploaded nominee photos live (back these up).
DATABASE_PATH=instance/apexrewards.db
UPLOAD_DIR=uploads

# Set to 1 when the site is served over HTTPS (strongly recommended in production).
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy (nginx, IIS ARR, a load balancer).
TRUST_PROXY=0

SESSION_HOURS=8
MAX_IMAGE_MB=5

# Creates the first administrator on startup if no users exist yet.
# The password must be changed at first sign-in. Remove these after first run.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
